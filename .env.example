NODE_ENV=development

# Gateway
API_GATEWAY_PORT=8080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fincommerce
POSTGRES_PASSWORD=fincommerce_password
POSTGRES_DB=fincommerce
DATABASE_URL=postgresql://fincommerce:fincommerce_password@postgres:5432/fincommerce?schema=public
AUTH_DATABASE_URL=postgresql://fincommerce:fincommerce_password@postgres:5432/fincommerce_auth?schema=public
AUTH_TEST_DATABASE_URL=postgresql://fincommerce:fincommerce_password@postgres:5432/fincommerce_auth_test?schema=public
USER_DATABASE_URL=postgresql://fincommerce:fincommerce_password@postgres:5432/fincommerce?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Kafka
KAFKA_BROKERS=kafka:9092

# Elasticsearch
ELASTICSEARCH_NODE=http://elasticsearch:9200

# Auth
AUTH_SERVICE_PORT=3001
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# User
USER_SERVICE_PORT=3002

# Security
BCRYPT_SALT_ROUNDS=12
OTP_EXPIRES_IN_MINUTES=5
ACCOUNT_LOCK_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
