generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("SELLER_DATABASE_URL")
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model SellerApplication {
  id             String       @id @default(uuid())
  userId         String       @unique
  email          String
  shopName       String
  businessName   String?
  businessPhone  String
  taxCode        String?
  description    String?
  status         SellerStatus @default(PENDING)
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@map("seller_applications")
}

model SellerProfile {
  id            String                @id @default(uuid())
  userId        String                @unique
  email         String
  shopName      String
  businessName  String?
  businessPhone String
  taxCode       String?
  description   String?
  status        SellerStatus          @default(APPROVED)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  statusHistory SellerStatusHistory[]

  @@index([status])
  @@map("seller_profiles")
}

model SellerStatusHistory {
  id        String        @id @default(uuid())
  sellerId  String
  fromStatus SellerStatus?
  toStatus   SellerStatus
  reason     String?
  changedBy  String
  createdAt  DateTime      @default(now())
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_status_history")
}
